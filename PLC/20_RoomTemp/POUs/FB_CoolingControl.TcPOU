<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_CoolingControl" Id="{c09f89a4-7fd2-41a6-a90f-53be9d89a7cd}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_CoolingControl IMPLEMENTS I_Cooling

VAR
	_bInit			: BOOL;
	
	_refHmi			: REFERENCE TO ST_CoolingControlHmi;
	_iMotor			: I_Motor;
	_iRoomTemp		: I_RoomTempControl;
	
	eCoolingState	: E_CoolingControlState;
	
	_fbBasicPID		: FB_BasicPID;
	_nPidOut		: LREAL;
	_nPidOutAbs		: LREAL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// rajapinnan kautta valvotaan huoneen läpmötilaa. keksitään PID yms säädin, joka nostaa tamun tehoja 
// kun lämpötila nousee...

IF _iMotor.bAuto AND _refHmi.bAuto THEN
	eCoolingState := E_CoolingControlState.Auto;
	
ELSIF _refHmi.bManual THEN
	eCoolingState := E_CoolingControlState.Manual;

ELSE
	eCoolingState := E_CoolingControlState.Stop;
	
END_IF

StateMachine();
MotorControl();]]></ST>
    </Implementation>
    <Property Name="bRunning" Id="{624f05f4-380a-49d8-8c3e-5f6815dbcbe2}">
      <Declaration><![CDATA[PROPERTY bRunning : BOOL]]></Declaration>
      <Get Name="Get" Id="{5d559f55-6d2a-4389-b098-fc08ff71713f}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[bRunning := _iMotor.bRunning;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="DataLogger" Id="{e2070f59-1543-46b4-8e65-a69e7fabe871}">
      <Declaration><![CDATA[METHOD DataLogger
VAR_INPUT
	SendData	:  I_Logger;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[SendData.CoolingControlLogger(THIS^);]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{fcfc5886-4c00-430c-bcfe-6efe2b92512a}">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)   
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_bInit := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Init" Id="{41d1ef6e-1d92-4a89-a068-5cd5a1e489d5}">
      <Declaration><![CDATA[METHOD Init : BOOL
VAR_INPUT
	
	refHmi			: REFERENCE TO ST_CoolingControlHmi;
	sName			: STRING;
	iMotor			: I_Motor;
	iRoomTemp		: I_RoomTempControl;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _bInit THEN
	
	_refHmi			REF= refHmi;
	_refHmi.sName	:= sName;
	_iMotor			:= iMotor;
	_iRoomTemp		:= iRoomTemp;





	_bInit := FALSE;
		
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="MotorControl" Id="{fca439e2-536d-4a5e-b82f-23ba2cccf372}">
      <Declaration><![CDATA[METHOD PRIVATE MotorControl
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[

_iMotor.bAuto := eCoolingState = E_CoolingControlState.Auto;
_iMotor.Update();]]></ST>
      </Implementation>
    </Method>
    <Property Name="nSpeed" Id="{590c0e67-0194-4f7e-98b8-d6334a5dcd49}">
      <Declaration><![CDATA[PROPERTY nSpeed : REAL]]></Declaration>
      <Get Name="Get" Id="{79630616-91ec-4ec4-9867-719260715bcd}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[nSpeed := LREAL_TO_REAL(MAX(0.0, MIN(100.0, _nPidOutAbs)));]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="StateMachine" Id="{fc3a95a4-aa4c-4d2d-b42b-fbab5f8880e3}">
      <Declaration><![CDATA[METHOD PRIVATE StateMachine : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE eCoolingState OF
	
	E_CoolingControlState.Auto:
		
			
			_fbBasicPID(	fSetpointValue	:= REAL_TO_LREAL(_refHmi.paramRoomTempSet), 
							fActualValue	:= REAL_TO_LREAL(_iRoomTemp.nRoomTemp), 
							bReset			:= 0, 
							fCtrlCycleTime	:= 0.01, 
							fKp				:= _refHmi.param_P, 
							fTn				:= _refHmi.param_I, 
							fTv				:= _refHmi.Param_D, 
							fTd				:= 0, 
							fCtrlOutput		=> _nPidOut, 
							nErrorStatus	=> );
							
							_nPidOutAbs := ABS(_nPidOut);
							_iMotor.nSpeed := LREAL_TO_INT( MAX(0.0, MIN(100.0, _nPidOutAbs)));
							
		
		
		IF _nPidOutAbs > 5 THEN
			_iMotor.bEnable := TRUE;
		ELSE
			_iMotor.bEnable := FALSE;
		END_IF
		
		
	E_CoolingControlState.Manual:
		_fbBasicPID(bReset := TRUE);
	
	E_CoolingControlState.Stop:
		_fbBasicPID(bReset := TRUE);
	
	E_CoolingControlState.Error:
		_fbBasicPID(bReset := TRUE);
	
END_CASE]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>