<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_RoomTempControl" Id="{85271c55-e02b-400b-8b22-1ffc8f0ff4f7}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_RoomTempControl IMPLEMENTS I_RoomTempControl

VAR
	// Seuraa onko generaattori päällä (tuottaa/varastoi). Tämän perusteella simuloi lämpötilan nousun.
	// Seruaa onko jäähdytys päällä. Tämän perusteella laskee lämpötilaa.
	_refHmi			: REFERENCE TO ST_RoomTempHmi;
	_bInit			: BOOL;
	_nCycleTime		: REAL := 0.01;
	_nRoomTemp		: REAL := 20.0;
	_nHeatingRate	: REAL;
	_nCoolingRate	: REAL;
	_nCoolingMax 	: REAL := 0.01;
	_bAlarm			: BOOL;
	// Interfaces
	_iGenerator		: I_Generator;
	_iCooling		: I_Cooling;

	
	
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
IF _iGenerator.bRunning THEN
	_nHeatingRate := 0.5 * (_iGenerator.nHeat / 100.0) * (_refHmi.nValue / 100.0);
	
	_nRoomTemp := _nRoomTemp + (_nHeatingRate * _nCycleTime);

ELSIF NOT _iGenerator.bRunning AND _nRoomTemp >= 20.0 THEN
	_nRoomTemp := _nRoomTemp - (0.0005 * _nCycleTime);
	
END_IF

IF _iCooling.bRunning AND _nRoomTemp > 19 THEN
	_nCoolingRate := _iCooling.nSpeed / 100.0;
	_nRoomTemp := _nRoomTemp - (_nCoolingMax * _nCoolingRate * _nCoolingRate);
END_IF

IF _nRoomTemp > 40 AND NOT _bAlarm THEN
	_bAlarm := TRUE;
	Alarm(	SendData := GVL.fbDataLogger._fbSqlDBMode,
			iKoodi := 'Lämpötila',
			iKuvaus	:= 'Lämpötila on ylittänyt asetusarvon');
ELSIF _nRoomTemp < 40 THEN
	_bAlarm := FALSE;	
END_IF

UpdateHmi();]]></ST>
    </Implementation>
    <Method Name="Alarm" Id="{94be2175-5281-47fe-a361-34258e83b09a}">
      <Declaration><![CDATA[METHOD Alarm
VAR_INPUT
	SendData	:  I_Alarm;
	iKoodi		: STRING;
	iKuvaus		: STRING;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[SendData.addAlarm( sKoodi := iKoodi,
					sKuvaus := iKuvaus);]]></ST>
      </Implementation>
    </Method>
    <Property Name="bAlarm" Id="{ab2888ac-5d26-4743-b95f-7f4eeb557b36}">
      <Declaration><![CDATA[PROPERTY bAlarm : BOOL]]></Declaration>
      <Get Name="Get" Id="{89d1ebbf-6bb3-4aa4-9803-b060b2f22261}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[bAlarm := _bAlarm;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{8831c31c-4cad-4b30-bf42-de84fa0f10ea}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="DataLogger" Id="{35a02a6c-66d2-472b-ae33-d256289c6905}">
      <Declaration><![CDATA[METHOD DataLogger
VAR_INPUT
	SendData	:  I_Logger;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[SendData.RoomTempLogger(THIS^);]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{a8415529-4b20-40d4-b1e3-770eda8edf35}">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)   
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_bInit := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Init" Id="{22fd7ed7-1bd2-4ad5-8128-eea6f8f4e8d2}">
      <Declaration><![CDATA[METHOD Init
VAR_INPUT
	refHmi			: REFERENCE TO ST_RoomTempHmi;
	sName			: STRING;
	iGenerator		: I_Generator;
	iCooling		: I_Cooling;

END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _bInit THEN
	
_refHmi 			REF= refHmi;

_refHmi.sName		:= sName;
_iGenerator			:= iGenerator;
_iCooling			:= iCooling;


_bInit := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="nRoomTemp" Id="{4df236b3-0f9c-47bc-8c84-3737b29a926c}">
      <Declaration><![CDATA[PROPERTY nRoomTemp : REAL]]></Declaration>
      <Get Name="Get" Id="{80c69a70-c044-4ae1-a9c5-b7833e2e74af}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[nRoomTemp := _nRoomTemp;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="UpdateHmi" Id="{0c9e6156-ecfc-4699-a54f-b2beaa50eb86}">
      <Declaration><![CDATA[METHOD INTERNAL UpdateHmi
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[

_refHmi.nRoomTemperature := _nRoomTemp;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>