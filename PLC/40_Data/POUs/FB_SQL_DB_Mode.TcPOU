<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_SQL_DB_Mode" Id="{332af01c-b846-48f1-a6fe-976448ab1a47}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_SQL_DB_Mode

VAR
	nCntr:		INT;

	fbMariaConnection:	FB_SQLDatabaseEvt(sNetID:= '192.168.68.113.1.1', tTimeout:= T#5S);	// DB connection handling
	fbSQLCommand:		FB_SQLCommandEvt(sNetID:= '192.168.68.113.1.1', tTimeout:= T#5S);	// DB read/write operations
	
	// Structurit tähän	DUT kansiosta
		// häly..
		// lämpö..
	stLampotilat:		ST_Lampotilat;
	bWriteRequest:		BOOL;	// Trig single write operation
	bSQLExecute:		BOOL;
	bSQLDone:			BOOL;
	sSQLCmd:			STRING(256);	// Actual SQL command structure to write into DB
	fbTON_DataSample:	TON := (PT:=T#1M);
	bLoggingActive:		BOOL;	// Manual activation
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[fbTON_DataSample.PT	 :=stLampotilat.tKirjoitussykli;

// Create 5s/1min write cycle
fbTON_DataSample(IN:=bLoggingActive);


bWriteRequest	:= SEL(fbTON_DataSample.Q, bWriteRequest, TRUE);

	// Create connection
IF(NOT(fbMariaConnection.bConnected) AND bWriteRequest) THEN
	fbMariaConnection.Connect(1);
END_IF

	// Create SQL command
IF(fbMariaConnection.bConnected AND bWriteRequest) THEN
	
	//Tää toimii!!!!	Lämpötilan kirjoitus 	
	sSQLCmd := CONCAT('INSERT INTO lampotilat (aikaleima, mittauspiste, lampotila, yksikko) VALUES (NOW(6), ', 
				CONCAT('$'', concat(stLampotilat.sMittauspiste, CONCAT('$', ', 
					CONCAT(LREAL_TO_STRING(stLampotilat.fLampotila), CONCAT(', ', 
						CONCAT('$'', concat(stLampotilat.sYksikko, '$')'))))))));

	fbMariaConnection.CreateCmd(ADR(fbSQLCommand));
	bSQLExecute	:= TRUE;
	bWriteRequest	:= FALSE;
	fbTON_DataSample(IN:=FALSE);
END_IF

//	Hälyn kirjoitus 

(*IF(fbMariaConnection.bConnected AND bWriteRequest) THEN
	
		

	sSQLCmd := CONCAT('INSERT INTO lampotilat (aikaleima, mittauspiste, lampotila, yksikko) VALUES (NOW(6), ', 
				CONCAT('$'', concat(stLampotilat.sMittauspiste, CONCAT('$', ', 
					CONCAT(LREAL_TO_STRING(stLampotilat.fLampotila), CONCAT(', ', 
						CONCAT('$'', concat(stLampotilat.sYksikko, '$')'))))))));

	fbMariaConnection.CreateCmd(ADR(fbSQLCommand));
	bSQLExecute	:= TRUE;
	bWriteRequest	:= FALSE;
	fbTON_DataSample(IN:=FALSE);
END_IF*)


	// Execute SQL command
IF(bSQLExecute) THEN
	fbSQLCommand.Execute(
		pSQLCmd:= ADR(sSQLCmd),
		cbSQLCmd:= SIZEOF(sSQLCmd));

	IF(NOT(fbSQLCommand.bBusy)) THEN
		bSQLExecute := FALSE;
		bSQLDone := TRUE;
	END_IF
END_IF

	// Release connection
IF(NOT(fbSQLCommand.bBusy) AND fbMariaConnection.bConnected AND NOT(bLoggingActive)) THEN
	fbMariaConnection.Disconnect();
	bWriteRequest	:= FALSE;
END_IF
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>