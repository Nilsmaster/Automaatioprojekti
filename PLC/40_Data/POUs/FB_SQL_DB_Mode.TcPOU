<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_SQL_DB_Mode" Id="{332af01c-b846-48f1-a6fe-976448ab1a47}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_SQL_DB_Mode IMPLEMENTS I_Logger, I_Alarm

VAR
	nCntr:		INT;

	fbMariaConnection:	FB_SQLDatabaseEvt(sNetID:= '192.168.68.113.1.1', tTimeout:= T#5S);	// DB connection handling
	fbSQLCommand:		FB_SQLCommandEvt(sNetID:= '192.168.68.113.1.1', tTimeout:= T#5S);	// DB read/write operations
	
	// Structurit tähän	DUT kansiosta
		// häly..
		// lämpö..
	fbLocalTime:		FB_LocalSystemTime;	
		
	stMittaukset:		ST_Mittaukset;
	stHalytykset:		ST_Halytykset;
	arrStHalytykset		: ARRAY [1..10] OF ST_Halytykset;
	nHwrite:			INT := 1;
	nHread:				INT := 1;
	nhalyId	:			INT;
	stTapahtumaloki:	ST_Tapahtumaloki;
	sLampotila:			STRING;
	sTeho:				STRING;
	sPinta:				STRING;
	sRPM:				STRING;
	bWriteRequest:		BOOL;	// Trig single write operation
	bSQLExecute:		BOOL;
	bSQLDone:			BOOL;
	sSQLCmd:			STRING(256);	// Actual SQL command structure to write into DB
	fbTON_DataSample:	TON := (PT:=T#1M);
	bLoggingActive:		BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[fbLocalTime(
	sNetID   := '',        // tyhjä = paikallinen kone
    bEnable  := TRUE,
    dwCycle  := 1,         // päivitysväli sekunteina
    dwOpt    := 0,
    tTimeout := T#5S);

fbTON_DataSample.PT	 :=stMittaukset.tKirjoitussykli;

// Create 5s/1min write cycle
//fbTON_DataSample(IN:=bLoggingActive);


bWriteRequest	:= SEL(fbTON_DataSample.Q, bWriteRequest, TRUE);

	// Create connection
IF(NOT(fbMariaConnection.bConnected) AND bWriteRequest) THEN
	fbMariaConnection.Connect(1);
END_IF

	//Lämpötilan kirjoitus 	

IF(fbMariaConnection.bConnected AND bWriteRequest AND NOT bLoggingActive) THEN
bLoggingActive  := TRUE;
sLampotila:=		LREAL_TO_STRING(stMittaukset.flampotila_c);
sTeho:=				LREAL_TO_STRING(stMittaukset.fgeneraattorin_teho_kw);
sPinta:=			LREAL_TO_STRING(stMittaukset.faltaan_pinta_prosenttia);
sRPM:= 				DINT_TO_STRING(stMittaukset.njaahdytyspumpun_rpm);


	sSQLCmd := CONCAT('INSERT INTO mittaukset (aikaleima, lampotila_c, generaattorin_teho_kw, altaan_pinta_prosenttia, jaahdytyspumpun_rpm)
						VALUES (NOW(6), ', CONCAT('$'', concat(sLampotila, CONCAT('$', ', CONCAT('$'', CONCAT(sTeho, CONCAT('$', ', CONCAT('$'', concat(sPinta, CONCAT('$', ', CONCAT('$'', concat(sRPM, '$')'))))))))))));
						
	fbMariaConnection.CreateCmd(ADR(fbSQLCommand));
	bSQLExecute	:= TRUE;
	bWriteRequest	:= FALSE;
	fbTON_DataSample(IN:=FALSE);
END_IF

	//Hälyn kirjoitus 					

IF(fbMariaConnection.bConnected AND arrStHalytykset[nHread].nID <> 0 AND NOT bLoggingActive) THEN
	bLoggingActive := TRUE;
	
	sSQLCmd := CONCAT('INSERT INTO halytykset (aikaleima, koodi, kuvaus)
						VALUES (NOW(6), ', CONCAT('$'', concat(stHalytykset.sKoodi, CONCAT('$', ', CONCAT('$'', CONCAT(stHalytykset.sKuvaus, '$')'))))));


	fbMariaConnection.CreateCmd(ADR(fbSQLCommand));
	bSQLExecute	:= TRUE;
	bWriteRequest	:= FALSE;
	fbTON_DataSample(IN:=FALSE);
	
		// hälytys array luku kontrolli
		arrStHalytykset[nHread].nID := 0;
		nHread := nHread + 1;
		IF nHread > 10 THEN
			nHread := 1;
		END_IF
END_IF

	//Tapahtumalokin kirjoitus 					
(*
IF(fbMariaConnection.bConnected (* AND  TAPAHTUMA TRIGGER*) AND NOT bLoggingActive) THEN
	bLoggingActive := TRUE;
	sSQLCmd := CONCAT('INSERT INTO tapahtumaloki (aikaleima, tapahtuma, kuvaus)
						VALUES (NOW(6), ', CONCAT('$'', concat(stTapahtumaloki.sTapahtuma, CONCAT('$', ', CONCAT('$'', CONCAT(stTapahtumaloki.sKuvaus, '$')'))))));


	fbMariaConnection.CreateCmd(ADR(fbSQLCommand));
	bSQLExecute	:= TRUE;
	bWriteRequest	:= FALSE;
	fbTON_DataSample(IN:=FALSE);
END_IF
*)


	// Execute SQL command
IF(bSQLExecute) THEN
	fbSQLCommand.Execute(
		pSQLCmd:= ADR(sSQLCmd),
		cbSQLCmd:= SIZEOF(sSQLCmd));

	IF(NOT(fbSQLCommand.bBusy)) THEN
		bSQLExecute := FALSE;
		bSQLDone := TRUE;
		bLoggingActive := FALSE;
	END_IF
END_IF


	// Release connection
IF(NOT(fbSQLCommand.bBusy) AND fbMariaConnection.bConnected AND NOT(bLoggingActive)) THEN
	fbMariaConnection.Disconnect();
	bWriteRequest	:= FALSE;
END_IF
]]></ST>
    </Implementation>
    <Method Name="addAlarm" Id="{f0f4c8e5-b8b1-4554-9d09-27473c9bfc8c}">
      <Declaration><![CDATA[METHOD addAlarm : BOOL
VAR_INPUT
	sKoodi		: STRING;
	sKuvaus		: STRING;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[stHalytykset.nID := nhalyId + 1;
IF fbLocalTime.bValid THEN
    stHalytykset.tAikaleima := SYSTEMTIME_TO_DT(fbLocalTime.systemTime);
END_IF
stHalytykset.sKoodi  := sKoodi;
stHalytykset.sKuvaus := sKuvaus;

arrStHalytykset[nHwrite] := stHalytykset;

nHwrite := nHwrite + 1;
IF nHwrite > 10 THEN 
    nHwrite := 1;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="CoolingControlLogger" Id="{bb720a7f-6ad4-4e96-a65f-6de3fc28d2c0}">
      <Declaration><![CDATA[METHOD CoolingControlLogger
VAR_INPUT
	iLogger		: I_Cooling;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//stMittaukset.CoolingRunning := iLogger.bRunning;
stMittaukset.njaahdytyspumpun_rpm 	:= REAL_TO_DINT(iLogger.nSpeed);]]></ST>
      </Implementation>
    </Method>
    <Method Name="GeneratorLogger" Id="{81aee581-37a4-4130-8779-c15d9df43470}">
      <Declaration><![CDATA[METHOD GeneratorLogger
VAR_INPUT
	iLogger		: I_Generator;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[stMittaukset.faltaan_pinta_prosenttia := iLogger.fAltaanpinta;
stMittaukset.fgeneraattorin_teho_kw	:= iLogger.fgeneraattorin_teho_kw;]]></ST>
      </Implementation>
    </Method>
    <Method Name="RoomTempLogger" Id="{e73d5902-d04d-41ec-a2d2-a52f23f24d80}">
      <Declaration><![CDATA[METHOD RoomTempLogger : BOOL
VAR_INPUT
	iLogger			: I_RoomTempControl;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[stMittaukset.flampotila_c := iLogger.nRoomTemp;
//stMittaukset.bAlarm :=  iLogger.bAlarm;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>