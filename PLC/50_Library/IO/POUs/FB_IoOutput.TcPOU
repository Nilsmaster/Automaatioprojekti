<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_IoOutput" Id="{3ef9086d-7c3f-4027-a1e4-b4895bc417b2}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_IoOutput IMPLEMENTS I_IoBit

VAR
	_bHw	AT %Q* : BOOL;
	_ftrig			: BOOL;
	_rtrig			: BOOL;
	_Q				: BOOL;
	
	_HwRtrig		: R_TRIG;
	_HwFtrig		: F_TRIG;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
_HwRtrig( CLK := _ftrig );
_HwFtrig( CLK := _rtrig );

_bHw		:= _Q OR _HwRtrig.Q OR _HwFtrig.Q;]]></ST>
    </Implementation>
    <Method Name="FB_Init" Id="{cdf08fc8-67a6-4b60-bfdf-e26a535869c4}">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change) 
	IoGroup		: I_IoGroup;  
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IoGroup.AddIo(THIS^);]]></ST>
      </Implementation>
    </Method>
