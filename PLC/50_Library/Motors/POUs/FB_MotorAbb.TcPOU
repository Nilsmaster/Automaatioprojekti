<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_MotorAbb" Id="{f0894974-da39-4fd7-b075-807b3aa1a4b6}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_MotorAbb IMPLEMENTS I_Motor

VAR
	// I/O
	wControlWord		AT %Q* : WORD;
	wStatusWord			AT %I* : WORD;
	nSpeedRef			AT %Q* : INT;
	nSpeedActual		AT %I* : INT;

	_bInit				: BOOL;
	_refHmi				: REFERENCE TO ST_Motors;
	
	// States
	_eState				: ( Not_ready_to_switch_on, 
							Switch_on_disabled, 
							Ready_to_Switch_on, Switched_on, 
							Operation_enabled, Quick_stop_active, 
							Fault_reaction_active, Fault, 
							Unknown_state);
							
	_eDriveMode			: ( Disabled, Manual, Auto );
	
	_bQuickStop			: BOOL;
	_bEnable			: BOOL;
	_bReset				: BOOL;
	_bRun				: BOOL;
	_bPowerReq			: BOOL;
	_nSpeed				: REAL;
	_nSpeedCmd			: REAL;
	_bStopping			: BOOL;
	_bStopped			: BOOL;
	_bModeChange		: BOOL;
	_bAuto				: BOOL;
	_bManual			: BOOL;
	_bManualFw			: BOOL;
	_bManualBw			: BOOL;
	_nManualSpeed		: REAL := 50;
	
	_bRampDown			: BOOL;
	
	_tonStop			: TON;
	_rtrigReset			: R_TRIG;
	_tofReset			: TOF;
END_VAR
VAR CONSTANT
	cScale				: REAL := 200.0;	// 1 % = 200 (100 % = 20000, vrt. ACS880 par. 46.01)
	cStopSpeedLimit		: REAL := 2.0;		// tämän alle -> ajo voidaan estää pysäytyksessä
	
	// StatusWord
	SwMask4F				: WORD := 16#004F;	// bitit 0,1,2,3,6     Päällä
	SwMask6F				: WORD := 16#006F;	// bitit 0,1,2,3,5,6   Päällä
	SwSwitchOnDisabled 		: WORD := 16#0040;
	SwReadyToSwitchOn		: WORD := 16#0021;
	SwSwitchedOn			: WORD := 16#0023;
	SwOperationEnabled		: WORD := 16#0027;
	SwQuickStopActive		: WORD := 16#0007;
	SwFault					: WORD := 16#0008;
	
	// ControlWord
	CwShutDown				: WORD := 16#0006; // 2, 6, 8
	CwSwitchOn				: WORD := 16#0007; // 3
	CwEnableOperation		: WORD := 16#000F; // 4
	CwDisableOperation		: WORD := 16#0007; // 5
	CwDisableVoltage		: WORD := 16#0000; // 9, 12
	CwQuickStop				: WORD := 16#0002; // 7, 10, 11
	CwFaultReset			: WORD := 16#0080; // 15
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[HmiCommands();
// tilan luku


IF    (wStatusWord AND SwMask4F) = SwSwitchOnDisabled	THEN _eState := Switch_on_disabled;
ELSIF (wStatusWord AND SwMask4F) = SwFault				THEN _eState := Fault;
ELSIF (wStatusWord AND SwMask6F) = SwReadyToSwitchOn	THEN _eState := Ready_to_Switch_on;
ELSIF (wStatusWord AND SwMask6F) = SwSwitchedOn			THEN _eState := Switched_on;
ELSIF (wStatusWord AND SwMask6F) = SwOperationEnabled	THEN _eState := Operation_enabled;
ELSIF (wStatusWord AND SwMask6F) = SwQuickStopActive	THEN _eState := Quick_stop_active;
ELSE                                                         _eState := Unknown_state;
END_IF


IF	_eDriveMode = Auto AND (_bManual OR NOT _bAuto) OR
	_eDriveMode = Manual AND (_bAuto OR NOT _bManual) THEN
	_bModeChange := TRUE;
	
END_IF

_bPowerReq := _bEnable AND NOT _bQuickStop AND _eState <> Fault;

// Hallittu pysäytys
_bStopping      := (_eState = Operation_enabled) AND NOT _bEnable OR (_eState = Operation_enabled) AND _bModeChange;
_tonStop(IN := _bStopping, PT := T#3S);
_bRampDown := _bStopping AND ABS(nSpeedActual) > cStopSpeedLimit AND NOT _tonStop.Q;
_bStopped := ABS(nSpeedActual) <= cStopSpeedLimit;


// ajotila

IF NOT _bEnable OR _bModeChange THEN
	_eDriveMode := Disabled;
END_IF

IF _eDriveMode = Disabled AND _bPowerReq THEN
	IF _bAuto AND _bStopped AND NOT _bManual THEN
		_eDriveMode := Auto;
		_bModeChange := FALSE;
		
	ELSIF _bManual AND _bStopped AND NOT _bAuto THEN
		_eDriveMode := Manual;
		_bModeChange := FALSE;
		
	ELSE
		_eDriveMode := Disabled;
	END_IF
END_IF

		CASE _eDriveMode OF
			Disabled:
			_bRun := FALSE;
			IF NOT _bRampDown THEN
			_bModeChange := FALSE;
			END_IF
			
			Manual:
			IF NOT _bManual THEN
				_eDriveMode := Disabled;
				
			ELSE
			
				IF _bManualFw XOR _bManualBw THEN
					_bRun 		:= TRUE;
					_nSpeedCmd 	:= _nManualSpeed;
					IF _bManualBw THEN
						_nSpeedCmd := -_nSpeedCmd;
					END_IF
				ELSE
					_bRun := FALSE;
					
				END_IF
			END_IF
			Auto:
			IF NOT _bAuto THEN
				_eDriveMode := Disabled;
			ELSE
				_bRun 		:= _bAuto;
				_nSpeedCmd 	:= _nSpeed;
			END_IF
		END_CASE

// vian kuittaus
_rtrigReset( CLK := _bReset);
_tofReset( IN := _rtrigReset.Q, PT := T#200MS);

// word nollaus
wControlWord := CwDisableVoltage;
CASE _eState OF
	
	Quick_stop_active:
	wControlWord := CwDisableVoltage;
	
	Fault:
		_bRun := FALSE;
		_eDriveMode := Disabled;
		IF _tofReset.Q THEN
			wControlWord := CwFaultReset; // 15
		END_IF

	Switch_on_disabled:
		wControlWord := CwShutDown; // 2
	
	Ready_to_Switch_on:
		IF _bPowerReq THEN
			wControlWord := CwSwitchOn; // 3
		ELSE
			wControlWord := CwShutDown; // 7
		END_IF
	
	Switched_on:
		IF _bPowerReq THEN
			IF _bRun THEN
			wControlWord := CwEnableOperation; // 4
			ELSE
			wControlWord := CwSwitchOn; // pysy 3
			
			END_IF
			
		ELSIF _bQuickStop THEN
			wControlWord := CwQuickStop; // 10
		ELSE
			wControlWord := CwShutDown; // 6
		END_IF
	
	Operation_enabled:
		IF _bQuickStop THEN
			wControlWord := CwQuickStop; // 11	
			
		ELSIF _bPowerReq OR _bRampDown THEN
			IF _bRun OR _bRampDown THEN
				wControlWord := CwEnableOperation; // pysyy
			ELSE
				wControlWord := CwDisableOperation; // 5
			END_IF

		ELSE 
			wControlWord := CwShutDown; // 8
		END_IF
	
END_CASE

IF _bRun AND NOT _bRampDown THEN
	_nSpeed := _nSpeedCmd;
ELSE
	_nSpeed := 0.0;
END_IF

nSpeedRef := REAL_TO_INT(LIMIT(-100.0, _nSpeed, 100.0) * cScale);	
	
]]></ST>
    </Implementation>
