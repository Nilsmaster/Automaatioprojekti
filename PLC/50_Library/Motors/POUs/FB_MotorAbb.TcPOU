    <Property Name="bRunning" Id="{251a9b1f-b57c-4461-9294-e6d29359e21b}">
      <Declaration><![CDATA[{warning 'Add property implementation'}
PROPERTY bRunning : BOOL
]]></Declaration>
      <Get Name="Get" Id="{86039136-adf1-4404-80b5-6bacb58303c8}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[bRunning := _eState = Operation_enabled;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="FB_Init" Id="{2e60556b-bb07-4942-b4c0-399e448809ec}">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)   
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_bInit := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="HmiCommands" Id="{fcc62b7e-0341-4754-be3d-ef1faf38719c}">
      <Declaration><![CDATA[METHOD INTERNAL HmiCommands
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF  __ISVALIDREF(_refHmi) THEN
_bAuto 			:= _refHmi.bAuto;
_bManual 		:= _refHmi.bManual;
_bManualBw 		:= _refHmi.bManualBw;
_bManualFw 		:= _refHmi.bManualFw;
_bReset 		:= _refHmi.bReset;
_nManualSpeed 	:= _refHmi.nManualSpeed;

	IF _refHmi.bStop THEN
		_bEnable := FALSE;

	END_IF
END_IF

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Init" Id="{6e5d4457-b3dd-4203-8df0-d4823adc332a}">
      <Declaration><![CDATA[METHOD Init
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _bInit THEN
	





_bInit := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
