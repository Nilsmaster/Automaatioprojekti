    <Property Name="bQuickStop" Id="{977fb5c2-a8bb-4f42-82b8-21f222960733}">
      <Declaration><![CDATA[PROPERTY bQuickStop : BOOL
]]></Declaration>
      <Set Name="Set" Id="{cd6e7d75-00b7-434b-bdd9-938a5c4facab}">
