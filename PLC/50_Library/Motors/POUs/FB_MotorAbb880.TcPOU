<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_MotorAbb880" Id="{eafde16a-d9d2-49c8-9aef-75aff923c034}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_MotorAbb880 IMPLEMENTS I_Motor

VAR
	stControlWord		AT %Q* : ST_ControlWord;
	stStatusWord		AT %I* : ST_StatusWord;
    nSpeedRef       	AT %Q* : INT;    
    nSpeedActual   	 	AT %I* : INT;

	_bEnable				   : BOOL;
	_bAuto					   : BOOL;

	_ftrig						: F_TRIG;      
	
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Tilakone — käynnistyssarja automaattisesti
IF stStatusWord.Fault THEN
    // Vika — disable voltage
    stControlWord.SwitchOn          := 0;
    stControlWord.EnableVoltage     := 0;
    stControlWord.QuickStop         := 1;
    stControlWord.EnableOperation   := 0;

ELSIF NOT stStatusWord.OperationEnabled THEN
    // Käynnistyssarja
    IF NOT stStatusWord.ReadyToSwitchOn THEN
        // Shutdown komento
        stControlWord.SwitchOn          := 0;
        stControlWord.EnableVoltage     := 1;
        stControlWord.QuickStop         := 1;
        stControlWord.EnableOperation   := 0;

    ELSIF NOT stStatusWord.SwitchedOn THEN
        // SwitchOn komento
        stControlWord.SwitchOn          := 1;
        stControlWord.EnableVoltage     := 1;
        stControlWord.QuickStop         := 1;
        stControlWord.EnableOperation   := 0;

    ELSE
        // EnableOperation komento
        stControlWord.SwitchOn          := 1;
        stControlWord.EnableVoltage     := 1;
        stControlWord.QuickStop         := 1;
        stControlWord.EnableOperation   := _bAuto;
    END_IF

ELSE
    // OperationEnabled — normaali ajo
    stControlWord.SwitchOn          := _bEnable;
    stControlWord.EnableVoltage     := 1;
    stControlWord.QuickStop         := 1;
    stControlWord.EnableOperation   := _bAuto;
END_IF

// Fault reset — auto clear
_ftrig(CLK := stControlWord.FaultReset);
IF _ftrig.Q THEN
    stControlWord.FaultReset := 0;
END_IF

// Nopeus — 0..100% → 0..20000
nSpeedRef := MAX(0, MIN(100, nSpeed)) * 200;]]></ST>
    </Implementation>
