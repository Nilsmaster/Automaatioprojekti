    <Method Name="FB_Init" Id="{fcd88a25-239f-459f-b4dc-8b11ef31c357}">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)   
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_bInit := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="fManualSpeed" Id="{201eb5e4-613a-49ed-9556-d99a3d7f46c7}">
      <Declaration><![CDATA[PROPERTY fManualSpeed : REAL
]]></Declaration>
      <Get Name="Get" Id="{710872eb-27b5-4a66-8189-6702bd092504}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[fManualSpeed := _fManualSpeed;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{63658fb3-e55f-4156-89fc-474ba76971a6}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[ IF _refHmi.nManualSpeed > fManualSpeed THEN
	_fManualSpeed := _refHmi.nManualSpeed;
ELSE
	_fManualSpeed := fManualSpeed;
END_IF

					]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="fSpeedActual" Id="{74a36abc-7604-4a50-99a2-c697211935ef}">
      <Declaration><![CDATA[PROPERTY fSpeedActual : REAL
]]></Declaration>
