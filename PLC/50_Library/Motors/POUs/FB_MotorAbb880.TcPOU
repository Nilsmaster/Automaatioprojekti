<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_MotorAbb880" Id="{eafde16a-d9d2-49c8-9aef-75aff923c034}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_MotorAbb880 IMPLEMENTS I_Motor

VAR CONSTANT
	cScale				: REAL := 200.0;	// 1 % = 200 (100 % = 20000, vrt. ACS880 par. 46.01)
	cStopSpeedLimit		: REAL := 2.0;		// [%] tämän alle -> ajo voidaan estää pysäytyksessä
END_VAR

VAR
	// --- Prosessikuva
	stControlWord		AT %Q* : ST_ControlWord;
	stStatusWord		AT %I* : ST_StatusWord;
	nSpeedRef			AT %Q* : INT;
	nSpeedActual		AT %I* : INT;

	_bInit				: BOOL;
	_refHmi				: REFERENCE TO ST_Motors;

	// --- Komennot (propertyjen kautta)
	_bEnable			: BOOL;			// Taajuusmuuttajan päävirta/valmius (SwitchOn)
	_bAuto				: BOOL;			// Käyntikäsky automaattiajossa
	_nSpeed				: INT;			// Nopeusohje automaattiajossa [%]
	_bManual			: BOOL;			// Valinta: TRUE = käsiajo, FALSE = automaatti
	_bManualFwd			: BOOL;			// Käsiajo eteen (pidä painettuna)
	_bManualRev			: BOOL;			// Käsiajo taakse (pidä painettuna)
	_fManualSpeed		: REAL := 10.0;	// Käsiajon nopeus [%]
	_fManualMax			: REAL := 20.0;	// Käsiajon nopeusraja [%]
	_bReset				: BOOL;			// Vikakuittaus
	_bQuickStop			: BOOL;			// TRUE = pikapysäytys (kytke NC-hätäseisoista: NOT bOk)

	// --- Sisäiset
	_eState				: (DRV_DISABLED := 0, DRV_READY, DRV_SWITCHED_ON, DRV_RUNNING, DRV_FAULT);
	_bActiveManual		: BOOL;			// Oikeasti käytössä oleva ajotapa
	_bRunInhibit		: BOOL;			// Vaatii uuden käynnistyskäskyn (tilanvaihto/vian jälkeen)
	_bPowerReq			: BOOL;
	_bRunReq			: BOOL;
	_fSpeedCmd			: REAL;
	_fSpeedRef			: REAL;
	_fSpeedActual		: REAL;
	_tStopTimeout		: TIME := T#10S;	// Max aika hallittuun pysäytykseen

	bRunRaw				: BOOL;
	bModeChangePending	: BOOL;
	bStopping			: BOOL;
	bKeepOperation		: BOOL;
	bWaiting			: BOOL;

	_rtReset			: R_TRIG;
	_tpReset			: TP;
	_tonStop			: TON;
	_tonWatch			: TON;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[HmiCommands();

// ============================================================
// 1. Tilan tulkinta statussanasta (CiA 402 -tilakone)
// ============================================================
IF stStatusWord.Fault THEN
    _eState := DRV_FAULT;
ELSIF stStatusWord.OperationEnabled THEN
    _eState := DRV_RUNNING;
ELSIF stStatusWord.SwitchedOn THEN
    _eState := DRV_SWITCHED_ON;
ELSIF stStatusWord.ReadyToSwitchOn THEN
    _eState := DRV_READY;
ELSE
    _eState := DRV_DISABLED;     // Not ready / Switch on disabled
END_IF

_fSpeedActual := INT_TO_REAL(nSpeedActual) / cScale;

// ============================================================
// 2. Ajotavan valinta (vaihto vain pysäytettynä)
// ============================================================
bModeChangePending := (_bManual <> _bActiveManual);
IF bModeChangePending AND (_eState <> DRV_RUNNING) THEN
    _bActiveManual     := _bManual;
    _bRunInhibit       := TRUE;          // ei automaattista käynnistystä vaihdon jälkeen
    bModeChangePending := FALSE;
END_IF

IF _bActiveManual THEN
    bRunRaw    := _bManualFwd XOR _bManualRev;
    _fSpeedCmd := LIMIT(0.0, _fManualSpeed, _fManualMax);
    IF _bManualRev THEN
        _fSpeedCmd := -_fSpeedCmd;
    END_IF
ELSE
    bRunRaw    := _bAuto;
    _fSpeedCmd := LIMIT(-100.0, INT_TO_REAL(_nSpeed), 100.0);   // rajaa 0..100 jos peruutus ei sallittu
END_IF

IF bModeChangePending THEN
    bRunRaw := FALSE;                    // pysäytä ensin
END_IF

// ============================================================
// 3. Käyntiluvat
// ============================================================
IF _eState = DRV_FAULT THEN
    _bRunInhibit := TRUE;                // vian jälkeen vaaditaan uusi käynnistyskäsky
END_IF
IF NOT bRunRaw THEN
    _bRunInhibit := FALSE;
END_IF

_bPowerReq := _bEnable AND NOT _bQuickStop;
_bRunReq   := _bPowerReq AND bRunRaw AND NOT _bRunInhibit;

// Hallittu pysäytys: nopeusohje 0 -> odota kunnes pysähtynyt (tai timeout) -> EnableOperation pois
bStopping      := (_eState = DRV_RUNNING) AND NOT _bRunReq AND _bPowerReq;
_tonStop(IN := bStopping, PT := _tStopTimeout);
bKeepOperation := bStopping AND (ABS(_fSpeedActual) > cStopSpeedLimit) AND NOT _tonStop.Q;

// Valvonta: pyydetty tila ei toteudu 5 s kuluessa (STO, local-tila, kenttäväylä...)
bWaiting := (_bPowerReq AND (_eState = DRV_DISABLED OR _eState = DRV_READY))
         OR (_bRunReq   AND _eState = DRV_SWITCHED_ON);
_tonWatch(IN := bWaiting, PT := T#5S);

// ============================================================
// 4. Vikakuittaus — nouseva reuna, pulssi 200 ms
// ============================================================
_rtReset(CLK := _bReset);
_tpReset(IN := _rtReset.Q AND (_eState = DRV_FAULT), PT := T#200MS);
stControlWord.FaultReset := _tpReset.Q;

// ============================================================
// 5. Ohjaussana
// ============================================================
IF _eState = DRV_FAULT THEN
    // Vika: disable voltage, odotetaan kuittausta
    stControlWord.SwitchOn        := FALSE;
    stControlWord.EnableVoltage   := FALSE;
    stControlWord.QuickStop       := TRUE;
    stControlWord.EnableOperation := FALSE;

ELSIF _bQuickStop THEN
    // Quick stop
    stControlWord.SwitchOn        := FALSE;
    stControlWord.EnableVoltage   := TRUE;
    stControlWord.QuickStop       := FALSE;
    stControlWord.EnableOperation := FALSE;

ELSIF NOT _bEnable THEN
    // Shutdown
    stControlWord.SwitchOn        := FALSE;
    stControlWord.EnableVoltage   := TRUE;
    stControlWord.QuickStop       := TRUE;
    stControlWord.EnableOperation := FALSE;

ELSE
    stControlWord.EnableVoltage   := TRUE;
    stControlWord.QuickStop       := TRUE;
    CASE _eState OF
        DRV_DISABLED:       // Shutdown
            stControlWord.SwitchOn        := FALSE;
            stControlWord.EnableOperation := FALSE;
        DRV_READY:          // Switch on
            stControlWord.SwitchOn        := TRUE;
            stControlWord.EnableOperation := FALSE;
        DRV_SWITCHED_ON:    // Enable operation vain käyntikäskyllä
            stControlWord.SwitchOn        := TRUE;
            stControlWord.EnableOperation := _bRunReq;
        DRV_RUNNING:
            stControlWord.SwitchOn        := TRUE;
            stControlWord.EnableOperation := _bRunReq OR bKeepOperation;
    END_CASE
END_IF

// ============================================================
// 6. Nopeusohje (-100..100 % -> -20000..20000)
// ============================================================
IF _bRunReq THEN
    _fSpeedRef := _fSpeedCmd;
ELSE
    _fSpeedRef := 0.0;                   // pysäytys ramppia pitkin ajon aikana
END_IF
nSpeedRef := REAL_TO_INT(LIMIT(-100.0, _fSpeedRef, 100.0) * cScale);
]]></ST>
    </Implementation>
