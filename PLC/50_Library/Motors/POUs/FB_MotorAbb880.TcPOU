        </Implementation>
      </Get>
    </Property>
    <Method Name="HmiCommands" Id="{4c850631-6bc7-4e13-9386-e1642356329b}">
      <Declaration><![CDATA[METHOD INTERNAL HmiCommands
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bAuto := _refHmi.bAuto;
bManual := _refHmi.bManual AND NOT _refHmi.bAuto;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Init" Id="{d510b2bb-44fc-4979-8d98-a0c064f5975d}">
      <Declaration><![CDATA[METHOD Init
VAR_INPUT
	sName		: STRING;
	refHmi		: REFERENCE TO ST_Motors;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _binit THEN
	_refHmi REF= refHmi;
	_refHmi.sName := sName;
END_IF]]></ST>
      </Implementation>
    </Method>
