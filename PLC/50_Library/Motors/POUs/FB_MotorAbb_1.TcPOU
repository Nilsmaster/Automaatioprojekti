    <Method Name="SetHmi" Id="{cef67595-cee4-4d22-ad5b-0cc13e6b588c}">
      <Declaration><![CDATA[METHOD SetHmi
VAR_IN_OUT
	stHmi		: ST_Motors;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_refHmi REF= stHmi;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetSpeed" Id="{25c95e95-5975-406f-91de-35590e5bb0e9}">
      <Declaration><![CDATA[METHOD SetSpeed : INT
VAR_INPUT
	fSpeed		: REAL;		// Automaattiajon nopeus [%]
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_fSpeed := fSpeed;
SetSpeed := REAL_TO_INT(LIMIT(-100.0, fSpeed, 100.0) * cScale);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>