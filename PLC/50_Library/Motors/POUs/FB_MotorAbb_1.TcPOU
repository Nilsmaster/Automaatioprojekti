<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_MotorAbb_1" Id="{0f5bbb36-62ef-4dc0-8765-495c23b2230e}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_MotorAbb_1

VAR
	// I/O
	wControlWord		AT %Q* : WORD;
	wStatusWord			AT %I* : WORD;
	nSpeedRef			AT %Q* : INT;
	nSpeedActual		AT %I* : INT;

	_bInit				: BOOL;
	_refHmi				: REFERENCE TO ST_Motors;

	// States
	_eState				: ( Not_ready_to_switch_on, Switch_on_disabled, Ready_to_Switch_on, Switched_on, Operation_enabled, Quick_stop_active, Fault_reaction_active, Fault, Unknown_state );
	_eDriveMode			: ( Disabled, Manual, Auto );					// pyydetty ajotapa
	_eActiveMode		: ( Act_Disabled, Act_Manual, Act_Auto );		// käytössä oleva ajotapa

	// Komennot
	_bQuickStop			: BOOL;			// TRUE = pikapysäytys (kytke NC-hätäseisoista: NOT bOk)
	_bEnable			: BOOL;			// Käyttölupa / päävirta (Switch on)
	_bAuto				: BOOL;			// Ajotavan valinta: automaatti
	_bManual			: BOOL;			// Ajotavan valinta: käsi
	_bAutoRun			: BOOL;			// Käyntikäsky automaattiajossa
	_bReset				: BOOL;			// Vikakuittaus
	_fSpeed				: REAL;			// Automaattiajon nopeus [%]
	_fManualSpeed		: REAL := 10.0;	// Käsiajon nopeus [%]
	_fManualMax			: REAL := 20.0;	// Käsiajon nopeusraja [%]
	_bManualFw			: BOOL;
	_bManualBw			: BOOL;

	// Sisäiset
	_bRunRaw			: BOOL;			// Käyntikäsky valitusta lähteestä
	_bRun				: BOOL;			// Lopullinen käyntipyyntö (luvat + inhibit huomioitu)
	_bPowerReq			: BOOL;			// Päävirta pyydetty (Switch on)
	_bRunInhibit		: BOOL;			// Vaatii uuden käynnistyskäskyn (vika / ajotavan vaihto)
	_bModeChangePending	: BOOL;
	_fSpeedCmd			: REAL;			// Nopeusohje valitusta lähteestä [%]
	_fSpeedRef			: REAL;			// Muuttajalle menevä ohje [%]
	_fSpeedActual		: REAL;			// Toteutunut nopeus [%]
	_bStopping			: BOOL;			// Pysäytys käynnissä (ajo päättyy)
	_bStopped			: BOOL;			// Nopeus alle pysähtymisrajan
	_bRampDown			: BOOL;			// Rampitus kesken -> pidä EnableOperation
	_bWaiting			: BOOL;

	_tStopTimeout		: TIME := T#10S;
	_tonStop			: TON;
	_tonWatch			: TON;
	_rtReset			: R_TRIG;
	_tpReset			: TP;
END_VAR
VAR CONSTANT
	cScale				: REAL := 200.0;	// 1 % = 200 (100 % = 20000, vrt. ACS880 par. 46.01)
	cStopSpeedLimit		: REAL := 2.0;		// [%] tämän alle -> ajo voidaan estää pysäytyksessä

	// StatusWord: maskit ja kuviot (CiA 402)
	SwMask4F				: WORD := 16#004F;	// bitit 0,1,2,3,6
	SwMask6F				: WORD := 16#006F;	// bitit 0,1,2,3,5,6
	SwNotReady				: WORD := 16#0000;	// maski 4F
	SwSwitchOnDisabled 		: WORD := 16#0040;	// maski 4F
	SwFaultReaction			: WORD := 16#000F;	// maski 4F
	SwFault					: WORD := 16#0008;	// maski 4F
	SwReadyToSwitchOn		: WORD := 16#0021;	// maski 6F
	SwSwitchedOn			: WORD := 16#0023;	// maski 6F
	SwOperationEnabled		: WORD := 16#0027;	// maski 6F
	SwQuickStopActive		: WORD := 16#0007;	// maski 6F
	SwBitWarning			: WORD := 16#0080;	// bitti 7
	SwBitRemote				: WORD := 16#0200;	// bitti 9

	// ControlWord
	CwDisableVoltage		: WORD := 16#0004;	// 9, 12; EV=0 (QS pidetään 1:ssä)
	CwShutDown				: WORD := 16#0006;	// 2, 6, 8
	CwSwitchOn				: WORD := 16#0007;	// 3
	CwEnableOperation		: WORD := 16#000F;	// 4
	CwDisableOperation		: WORD := 16#0007;	// 5
	CwQuickStop				: WORD := 16#0002;	// 7, 10, 11
	CwBitFaultReset			: WORD := 16#0080;	// 15: bitti 7, nouseva reuna
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// 0. Ajotavan valinta ja käsiajon suunta HMI:ltä
// ============================================================
DriveMode();

// ============================================================
// 1. Tilan valinta bittimaskilla (kuvio verrataan maskattuun statussanaan)
//    Jos asema ei raportoi bittiä 5: maski 6F -> 4F ja kuviot 21/23/27 -> 01/03/07
// ============================================================
IF    (wStatusWord AND SwMask4F) = SwNotReady			THEN _eState := Not_ready_to_switch_on;
ELSIF (wStatusWord AND SwMask4F) = SwSwitchOnDisabled	THEN _eState := Switch_on_disabled;
ELSIF (wStatusWord AND SwMask4F) = SwFaultReaction		THEN _eState := Fault_reaction_active;
ELSIF (wStatusWord AND SwMask4F) = SwFault				THEN _eState := Fault;
ELSIF (wStatusWord AND SwMask6F) = SwReadyToSwitchOn	THEN _eState := Ready_to_Switch_on;
ELSIF (wStatusWord AND SwMask6F) = SwSwitchedOn			THEN _eState := Switched_on;
ELSIF (wStatusWord AND SwMask6F) = SwOperationEnabled	THEN _eState := Operation_enabled;
ELSIF (wStatusWord AND SwMask6F) = SwQuickStopActive	THEN _eState := Quick_stop_active;
ELSE                                                         _eState := Unknown_state;
END_IF

_fSpeedActual := INT_TO_REAL(nSpeedActual) / cScale;

// ============================================================
// 2. Ajotavan vaihto vain pysäytettynä
// ============================================================
CASE _eDriveMode OF
	Disabled:	_bModeChangePending := (_eActiveMode <> Act_Disabled);
	Manual:		_bModeChangePending := (_eActiveMode <> Act_Manual);
	Auto:		_bModeChangePending := (_eActiveMode <> Act_Auto);
END_CASE

IF _bModeChangePending AND (_eState <> Operation_enabled) THEN
	CASE _eDriveMode OF
		Disabled:	_eActiveMode := Act_Disabled;
		Manual:		_eActiveMode := Act_Manual;
		Auto:		_eActiveMode := Act_Auto;
	END_CASE
	_bRunInhibit        := TRUE;		// ei automaattista käynnistystä vaihdon jälkeen
	_bModeChangePending := FALSE;
END_IF

// ============================================================
// 3. Käyntikäsky ja nopeusohje valitusta lähteestä (joka kierroksella)
// ============================================================
CASE _eActiveMode OF
	Act_Auto:
		_bRunRaw   := _bAutoRun;
		_fSpeedCmd := LIMIT(-100.0, _fSpeed, 100.0);			// rajaa 0..100 jos peruutus ei sallittu

	Act_Manual:
		_bRunRaw   := _bManualFw XOR _bManualBw;
		_fSpeedCmd := LIMIT(0.0, _fManualSpeed, _fManualMax);
		IF _bManualBw THEN
			_fSpeedCmd := -_fSpeedCmd;
		END_IF

	ELSE
		_bRunRaw   := FALSE;
		_fSpeedCmd := 0.0;
END_CASE

IF _bModeChangePending THEN
	_bRunRaw := FALSE;						// pysäytä ensin
END_IF

IF _eState = Fault OR _eState = Fault_reaction_active THEN
	_bRunInhibit := TRUE;					// vian jälkeen vaaditaan uusi käynnistyskäsky
END_IF
IF NOT _bRunRaw THEN
	_bRunInhibit := FALSE;
END_IF

_bPowerReq := _bEnable AND NOT _bQuickStop AND (_eActiveMode <> Act_Disabled);
_bRun      := _bPowerReq AND _bRunRaw AND NOT _bRunInhibit;

// ============================================================
// 4. Hallittu pysäytys: ohje 0 -> odota pysähtymistä (tai timeout) -> Disable operation
// ============================================================
_bStopping := (_eState = Operation_enabled) AND _bPowerReq AND NOT _bRun;
_tonStop(IN := _bStopping, PT := _tStopTimeout);
_bStopped  := ABS(_fSpeedActual) < cStopSpeedLimit;
_bRampDown := _bStopping AND NOT _bStopped AND NOT _tonStop.Q;		// rampitus kesken

// Valvonta: pyydetty tila ei toteudu 5 s kuluessa (STO, Local-tila, kenttäväylä...)
_bWaiting := (_bPowerReq AND (_eState = Not_ready_to_switch_on
                           OR _eState = Switch_on_disabled
                           OR _eState = Ready_to_Switch_on))
          OR (_bRun      AND _eState = Switched_on);
_tonWatch(IN := _bWaiting, PT := T#5S);

// ============================================================
// 5. Vikakuittaus: pulssi 200 ms (bitti 7 on ennen sitä 0 -> nouseva reuna)
// ============================================================
_rtReset(CLK := _bReset);
_tpReset(IN := _rtReset.Q AND (_eState = Fault), PT := T#200MS);

// ============================================================
// 6. Ohjaussana tiloittain (oletus joka kierroksella = ei vanhoja arvoja)
// ============================================================
wControlWord := CwDisableVoltage;

CASE _eState OF

	Not_ready_to_switch_on,
	Fault_reaction_active,
	Unknown_state:
		wControlWord := CwDisableVoltage;				// muuttuja hoitaa itse (0, 1, 14)

	Fault:
		IF _tpReset.Q THEN
			wControlWord := CwDisableVoltage OR CwBitFaultReset;	// (15)
		END_IF

	Switch_on_disabled:
		IF _bPowerReq THEN
			wControlWord := CwShutDown;					// (2)
		END_IF

	Ready_to_Switch_on:
		IF _bPowerReq THEN
			wControlWord := CwSwitchOn;					// (3)
		END_IF											// muuten (7) Disable voltage

	Switched_on:
		IF _bPowerReq THEN
			IF _bRun THEN
				wControlWord := CwEnableOperation;		// (4)
			ELSE
				wControlWord := CwSwitchOn;
			END_IF
		ELSIF _bQuickStop THEN
			wControlWord := CwQuickStop;				// (10)
		ELSE
			wControlWord := CwShutDown;					// (6)
		END_IF

	Operation_enabled:
		IF _bPowerReq THEN
			IF _bRun OR _bRampDown THEN
				wControlWord := CwEnableOperation;		// ajo / hallittu pysäytys
			ELSE
				wControlWord := CwDisableOperation;		// (5) pysähtynyt
			END_IF
		ELSIF _bQuickStop THEN
			wControlWord := CwQuickStop;				// (11), ensisijainen
		ELSE
			wControlWord := CwShutDown;					// (8) lupa pois / Disabled-tila
		END_IF

	Quick_stop_active:
		IF _bQuickStop THEN
			wControlWord := CwQuickStop;				// pidä kunnes pysähtynyt
		END_IF											// muuten (12) Disable voltage
END_CASE

// ============================================================
// 7. Nopeusohje joka kierroksella (-100..100 % -> -20000..20000)
// ============================================================
IF _bRun THEN
	_fSpeedRef := _fSpeedCmd;
ELSE
	_fSpeedRef := 0.0;						// pysäytys ramppia pitkin
END_IF
nSpeedRef := REAL_TO_INT(LIMIT(-100.0, _fSpeedRef, 100.0) * cScale);
]]></ST>
    </Implementation>
    <Property Name="bAuto" Id="{627ad2b8-db7e-40ab-ae2e-04f95dd0442c}">
      <Declaration><![CDATA[PROPERTY bAuto : BOOL
]]></Declaration>
      <Get Name="Get" Id="{a8835379-be76-495b-8bb9-c6c17344476a}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[bAuto := _bAuto;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{d1d2ef8d-a6b0-46f7-9108-05907a9b2ca2}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[_bAuto := bAuto;]]></ST>
        </Implementation>
      </Set>
    </Property>
