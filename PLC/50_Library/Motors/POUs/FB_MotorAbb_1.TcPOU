]]></Declaration>
      <Get Name="Get" Id="{c7baa816-32f6-4329-b957-a1ac895a2e8b}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[bEnable := _bEnable;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{70a9ca0e-f54c-4b4c-811b-4135c709d7a6}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[_bEnable := bEnable;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="bFault" Id="{e0dc487c-8e0d-4270-aef8-cc394e5631e4}">
      <Declaration><![CDATA[PROPERTY bFault : BOOL
]]></Declaration>
      <Get Name="Get" Id="{9d196b61-f02f-49ce-b095-75a437c4ec14}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[bFault := (_eState = Fault) OR (_eState = Fault_reaction_active);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="bManual" Id="{dfb5fb5a-ecc1-4dc0-859c-e9edfcc3bec7}">
      <Declaration><![CDATA[PROPERTY bManual : BOOL
]]></Declaration>
      <Get Name="Get" Id="{b8466f5f-64b6-4034-b3a7-8c2b492c31c5}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[bManual := _bManual;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{3098a344-dc02-49f3-9f27-5c7f8dafd93b}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[_bManual := bManual;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="bQuickStop" Id="{94af7cec-ef4e-440a-baa7-765a21087d81}">
      <Declaration><![CDATA[PROPERTY bQuickStop : BOOL
]]></Declaration>
      <Set Name="Set" Id="{7df557e9-6bfb-42d5-ab08-b908014a38ac}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[_bQuickStop := bQuickStop;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="bRemote" Id="{6e1af3f3-3d34-4e41-b62e-b75ea70d4501}">
      <Declaration><![CDATA[PROPERTY bRemote : BOOL
]]></Declaration>
      <Get Name="Get" Id="{17aa0e6b-6288-420c-9985-ec2794eff4b1}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[bRemote := (wStatusWord AND SwBitRemote) <> 0;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="bReset" Id="{835ef28b-e3bc-4293-8cbc-68ff1ff61247}">
      <Declaration><![CDATA[PROPERTY bReset : BOOL
]]></Declaration>
      <Set Name="Set" Id="{5d9beb84-61e8-46ac-a628-bf292145852a}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[_bReset := bReset;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="bRunning" Id="{fb57bed6-bab0-4f3c-a60a-e78c6f50b151}">
      <Declaration><![CDATA[PROPERTY bRunning : BOOL
]]></Declaration>
      <Get Name="Get" Id="{179b9181-004f-4f4f-a5f9-db55025c830d}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[bRunning := _eState = Operation_enabled;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="bTimeout" Id="{80fe5fd0-1101-4939-b88b-d5a42dd0b3ee}">
      <Declaration><![CDATA[PROPERTY bTimeout : BOOL
]]></Declaration>
      <Get Name="Get" Id="{ab9e74eb-8df1-4b3b-8679-554bc150b8b1}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[bTimeout := _tonWatch.Q;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="bWarning" Id="{52030919-b6d9-4369-a62c-aec92954bbf3}">
      <Declaration><![CDATA[PROPERTY bWarning : BOOL
]]></Declaration>
      <Get Name="Get" Id="{c4d34eed-5a88-4e21-8352-a19b284bca3c}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[bWarning := (wStatusWord AND SwBitWarning) <> 0;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="DriveMode" Id="{b78c8679-e706-4d29-8726-5b4fb576d512}">
      <Declaration><![CDATA[METHOD INTERNAL DriveMode : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
IF _bAuto AND NOT _bManual THEN
	_eDriveMode := Auto;
ELSIF _bManual AND NOT _bAuto THEN
	_eDriveMode := Manual;
ELSE
	_eDriveMode := Disabled;			// molemmat tai ei kumpaakaan -> pois
END_IF

// Käsiajon suunta HMI:ltä: molemmat painettuna = ei ajoa
_bManualFw := FALSE;
_bManualBw := FALSE;
IF __ISVALIDREF(_refHmi) AND (_eDriveMode = Manual) THEN
	_bManualFw := _refHmi.bManualFw AND NOT _refHmi.bManualBw;
	_bManualBw := _refHmi.bManualBw AND NOT _refHmi.bManualFw;
END_IF

DriveMode := TRUE;]]></ST>
      </Implementation>
    </Method>
