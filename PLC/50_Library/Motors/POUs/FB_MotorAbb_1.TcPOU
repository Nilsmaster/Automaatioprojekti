        </Implementation>
      </Get>
      <Set Name="Set" Id="{400d369f-e7b9-425b-9c81-e01c209df9d8}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[_bAutoRun := bAutoRun;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="bEnable" Id="{abf95151-140a-4c62-b902-88ce1bba9209}">
